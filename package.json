{
  "name": "ritmo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n shared,api,web \"npm run dev -w @ritmo/shared\" \"npm run dev -w @ritmo/api\" \"npm run dev -w @ritmo/web\"",
    "predev": "npm run build -w @ritmo/shared",
    "build": "npm run build -w @ritmo/shared && npm run build -w @ritmo/web && npm run build -w @ritmo/api",
    "typecheck": "npm run build -w @ritmo/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages prisma scripts tests --max-warnings 0",
    "format": "prettier --write apps packages prisma scripts tests *.json *.ts *.md *.yml",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "vapid:generate": "node scripts/vapid.mjs",
    "start": "npm run start -w @ritmo/api",
    "postinstall": "prisma generate && npm run build -w @ritmo/shared",
    "test:browser": "playwright test",
    "bootstrap:user": "tsx --tsconfig apps/api/tsconfig.json scripts/bootstrap-user.ts",
    "profile:import": "tsx --tsconfig apps/api/tsconfig.json scripts/import-profile.ts",
    "verify:user": "node scripts/verify-user.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "deployment:env": "node scripts/deployment-env.mjs",
    "data:migrate": "tsx --tsconfig apps/api/tsconfig.json scripts/migrate-personal-data.ts",
    "scheduler:configure": "node scripts/configure-hosted-scheduler.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "prisma": "7.10.0",
    "supertest": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
